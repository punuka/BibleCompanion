# Copy to .env and fill in.

# Required. Get one at https://aistudio.google.com/apikey (free tier).
GEMINI_API_KEY=AIza...

# Optional. Fallback provider for when Gemini errors out (quota, an
# overloaded model, an outage) — Gemini stays primary either way. Get a free
# key at https://console.groq.com/keys. Leave blank to run without a
# fallback; chat/comfort work fine, they just surface Gemini's error as-is.
GROQ_API_KEY=

# Required. Any random string of 32+ characters. Changing it invalidates all tokens.
JWT_SECRET=change-me-to-something-long-and-random-at-least-32-chars

# SQLite for local dev. For production, switch the provider in
# prisma/schema.prisma to "postgresql" and put the connection string here.
DATABASE_URL="file:./dev.db"

PORT=8787

# 0.0.0.0 so emulators and physical devices on the LAN can reach the API.
# 127.0.0.1 would only be reachable from this machine.
HOST=0.0.0.0

# Comma-separated origins allowed to call the API from a browser.
# The Expo web preview runs on 8081.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
