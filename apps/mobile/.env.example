# Copy to .env. This value is inlined at BUNDLE time — restart the Expo dev
# server after changing it, or the app keeps using the old value.
#
# Which value to use depends on where the app runs. `localhost` means "this
# device", so it is wrong everywhere except the web preview and the iOS simulator.
#
#   Web preview (press w) .... http://localhost:8787
#   Android emulator (AVD) ... http://10.0.2.2:8787
#   Genymotion ............... http://10.0.3.2:8787
#   iOS simulator (macOS) .... http://localhost:8787
#   Physical device .......... http://<your-LAN-IP>:8787   (ipconfig on Windows)
#
# See .claude/skills/bible-companion/references/emulators.md

EXPO_PUBLIC_API_URL=http://localhost:8787
